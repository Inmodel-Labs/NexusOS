{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "deploy": "wrangler pages deploy",
    "build": "next build && chmod +x wrangler-shim.cjs",
    "postinstall": "mkdir -p node_modules/.bin && ln -sf ../../wrangler-shim.cjs node_modules/.bin/wrangler"
  },
  "bin": {
    "wrangler": "./wrangler-shim.cjs"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^3.114.17"
  }
}
